<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
    <nav class="w-full bg-blue-200 flex justify-between px-5 py-3">
      <img src="/images/logo.png" alt="logo" class="w-36 h-auto">
        <div class="flex gap-5">
          <a class="mt-2 mr-2" href="/account">Back</a>
          
        </div>
   <% } %>
    </nav>

<div>
<form action="/editprofile/<%= user._id %>" method="post">
    <h1 class="text-3xl m-5">Edit Your Profile</h1>
    <div class="flex flex-col items-start ml-10 mt-10 gap-7">
    <input class="px-2 py-1 bg-black text-white rounded-lg" name="fullname" type="text" placeholder="Full Name" value="<%= user.fullname %>" >
    <input class="px-2 py-1 bg-black text-white rounded-lg" name="email" type="text" placeholder="email" value="<%= user.email %>" >
        <button type="submit" class="ml-16 bg-blue-500 text-white px-5 py-1 rounded-md" >Change</button>
</div>
</form>
</div>
 <%- include('./partials/footer') %>
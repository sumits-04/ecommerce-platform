 <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
   <nav class="sticky top-0 z-50 w-screen bg-blue-200 flex flex-col sm:flex-row items-center justify-between px-4 sm:px-5 py-3 shadow-md">
      <img src="/images/logo.png" alt="logo" class="w-28 sm:w-32 md:w-36 h-auto">
        <div class="mt-3 sm:mt-0 mr-0 sm:mr-2 flex flex-wrap justify-center items-center gap-3 sm:gap-5">
          <a class="text-sm sm:text-base" href="/account">Back</a>
          
        </div>
   <% } %>
    </nav>

<div class="w-full px-4 sm:px-6 md:px-10">
<form action="/editprofile/<%= user._id %>" method="post">
    <h1 class="text-2xl sm:text-3xl font-bold mt-6 mb-6">Edit Your Profile</h1>
    <div class="flex flex-col items-start mt-5 sm:mt-10 gap-5 sm:gap-7 max-w-md">
    <input class="w-full px-3 py-2 bg-black text-white rounded-lg" name="fullname" type="text" placeholder="Full Name" value="<%= user.fullname %>" >
    <input class="w-full px-3 py-2 bg-black text-white rounded-lg" name="email" type="text" placeholder="email" value="<%= user.email %>" >
        <button type="submit" class="bg-blue-500 text-white px-5 py-2 rounded-md">Change</button>
</div>
</form>
</div>
 <%- include('./partials/footer') %>
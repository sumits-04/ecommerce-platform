<%- include('./partials/header') %>

 <%
let total = 0;
  let hasProduct= false;

user.cart.forEach((item) => {
if(item.product){
    hasProduct = true;
    total += (item.product.price - item.product.discount + 20) * item.quantity;
}
}); 
%>

<div class="flex flex-row flex-wrap px-10 py-10 gap-16">

<% if(!hasProduct){ %>

    <div class="w-full h-screen flex justify-center items-center">
        <h1 class="text-2xl font-bold text-black">
            Empty Cart
        </h1>
    </div>

<% } else { %>


<%
user.cart.forEach((item)=>{ 
if(item.product){
    const itembill= (item.product.price - item.product.discount + 20) * item.quantity;
    %>

        <div class="w-[20%]  rounded-md overflow-hidden">
            <div class="w-full flex justify-center items-center h-40 bg-[<%= item.product.bgcolor %>]">
                <img class="h-[9rem]" src="data:image/jpeg;base64, <%= item.product.image.toString('base64') %>" alt="<%= item.product.name %>">
            </div>
            <div class="w-full flex justify-between px-3 py-2 bg-[<%= item.product.panelcolor %>]">
                <h3 class="text-lg"><%= item.product.name %></h3>
                <div class="flex items-center gap-1">
         <% if (item.quantity > 1) { %>
    <a href="/decrease/<%= item.product._id %>">
        <i class="w-5 h-5 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
    </a>
<% } else { %>
    <span>
        <i class="w-5 h-5 bg-gray-300 text-gray-500 flex rounded-full items-center justify-center ri-subtract-line cursor-not-allowed"></i>
    </span>
<% } %>
        <div class="px-1 py-0.5 rounded-md bg-white text-black"><%= item.quantity %></div>
        <a href="/increase/<%= item.product._id %>">
                <i class="w-5 h-5 bg-white flex rounded-full items-center justify-center ri-add-line"></i>
            </a>
                </div>
            </div>
            <div class="flex text-white items-center justify-between px-3 py-1 bg-[<%= item.product.textcolor %>]">
                <h4 class="text-lg">Price</h4>
                <h2 class="text-lg">₹ <%= item.product.price %></h2>
            </div>
            <form action="/removefromcart/<%= item.product._id %>" method="POST">
    <button type="submit" class="text-red-500 hover:underline">
        Remove from Cart
    </button>
</form>
             <div class="w-full mt-3">
            <h3 class="text-xl flex justify-center underline">Price Breakdown</h3>
            <div class="px-2 mt-2">
                <div class="flex justify-between mt-2">
                    <h4 class="w-1/3">Total MRP</h4>
                    <h4><%= item.product.price * item.quantity %></h4>
                </div>
                <div class="flex justify-between mt-2">
                    <h4 class="w-1/3">Discount on MRP</h4>
                    <h4><%= item.product.discount * item.quantity %></h4>
                </div>
                <div class="flex justify-between mt-2">
                    <h4 class="w-1/3">Platform Fee</h4>
                    <h4>₹ 20</h4>
                </div>
                <div class="flex justify-between mt-2">
                    <h4 class="w-1/3">Shipping Fee</h4>
                    <h4>FREE</h4>
                </div>
            </div>
            <div class="w-full h-[1px] bg-black mt-5"></div>
            <div class="flex justify-between mt-5">
                <h3 class="w-1/3 text-xl">Net Total</h3>
                <h3 class="font-semibold text-xl text-green-600">₹ <%= itembill %></h3>
            </div>
        </div>
        </div>
    
  
  <% }
}); 
%>
  </div>

<div class="sticky bottom-3 ml-auto mr-3 w-[250px] bg-yellow-400 rounded-lg shadow-lg p-2">
    <div class="flex justify-between items-center">
        <h4 class="font-semibold text-black text-xl">
            Total Amount
        </h4>

        <h2 class="font-bold text-black text-xl">
            ₹ <%= total %>
        </h2>
    </div>
</div>

<% } %>

    <%- include('./partials/footer') %>

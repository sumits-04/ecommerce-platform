<%- include('./partials/header') %>

 <%
let total = 0;
  let hasProduct= false;

user.cart.forEach((item) => {
if(item.product){
    hasProduct = true;
    total += (item.product.price - item.product.discount + 20) * item.quantity;
}
}); 
%>

<div class="flex flex-row flex-wrap px-4 sm:px-6 lg:px-10 py-6 lg:py-10 gap-6 lg:gap-10">

<% if(!hasProduct){ %>

    <div class="w-full min-h-[60vh] flex justify-center items-center">
    <h1 class="text-xl sm:text-2xl font-bold text-black">
        Empty Cart
    </h1>
</div>

<% } else { %>


<%
user.cart.forEach((item)=>{ 
if(item.product){
    const itembill= (item.product.price - item.product.discount + 20) * item.quantity;
    %>

        <div class="w-full lg:w-[calc(25%-30px)] rounded-md overflow-hidden">
            <div class="w-full flex justify-center items-center h-40 bg-[<%= item.product.bgcolor %>]">
                <img class="h-32 sm:h-36 md:h-40 object-contain" src="data:image/jpeg;base64, <%= item.product.image.toString('base64') %>" alt="<%= item.product.name %>">
            </div>
            <div class="w-full flex justify-between gap-3 px-3 py-2 bg-[<%= item.product.panelcolor %>]">
                <h3 class="text-base sm:text-lg truncate"><%= item.product.name %></h3>
                <div class="flex items-center gap-1">
         <% if (item.quantity > 1) { %>
    <a href="/decrease/<%= item.product._id %>">
        <i class="w-5 h-5 lex-shrink-0 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
    </a>
<% } else { %>
    <span>
        <i class="w-5 h-5 lex-shrink-0 bg-gray-300 text-gray-500 flex rounded-full items-center justify-center ri-subtract-line cursor-not-allowed"></i>
    </span>
<% } %>
        <div class="px-1 py-0.5 rounded-md bg-white text-black"><%= item.quantity %></div>
        <a href="/increase/<%= item.product._id %>">
                <i class="w-5 h-5 bg-white flex rounded-full items-center justify-center ri-add-line"></i>
            </a>
                </div>
            </div>
            <div class="flex text-white items-center justify-between px-3 py-1 bg-[<%= item.product.textcolor %>]">
                <h4 class="text-lg">Price</h4>
                <h2 class="text-lg">₹ <%= item.product.price %></h2>
            </div>
            <form action="/removefromcart/<%= item.product._id %>" method="POST">
    <button
    type="submit"
    class="text-red-500 hover:underline text-sm sm:text-base py-1"
>
    Remove from Cart
</button>
</form>
             <div class="w-full mt-3">
            <h3 class="text-xl flex justify-center underline">Price Breakdown</h3>
            <div class="px-2 mt-2">
                <div class="flex justify-between items-start gap-3 mt-2">
    <h4 class="text-sm sm:text-base">
        Total MRP
    </h4>
    <h4 class="text-sm sm:text-base text-right">
        <%= item.product.price * item.quantity %>
    </h4>
</div>
                <div class="flex justify-between items-start gap-3 mt-2">
    <h4 class="text-sm sm:text-base">
        Discount on MRP
    </h4>
    <h4 class="text-sm sm:text-base text-right">
        <%= item.product.discount * item.quantity %>
    </h4>
</div>
                <div class="flex justify-between items-start gap-3 mt-2">
    <h4 class="text-sm sm:text-base">Platform Fee</h4>
    <h4 class="text-sm sm:text-base">₹ 20</h4>
</div>
                <div class="flex justify-between items-start gap-3 mt-2">
    <h4 class="text-sm sm:text-base">Shipping Fee</h4>
    <h4 class="text-sm sm:text-base">FREE</h4>
</div>
            </div>
            <div class="w-full h-[1px] bg-black mt-5"></div>
            <div class="flex justify-between items-center gap-3 mt-5">
    <h3 class="text-lg sm:text-xl">
        Net Total
    </h3>

    <h3 class="font-semibold text-lg sm:text-xl text-green-600">
        ₹ <%= itembill %>
    </h3>
</div>
        </div>
        </div>
    
  
  <% }
}); 
%>
  </div>

<div class="sticky bottom-3 ml-2 mr-2 sm:ml-auto sm:mr-3 w-auto sm:w-[250px] bg-yellow-400 rounded-lg shadow-lg p-3">
    <div class="flex justify-between items-center gap-3">
        <h4 class="font-semibold text-black text-xl">
            Total Amount
        </h4>

        <h2 class="font-bold text-black text-xl">
            ₹ <%= total %>
        </h2>
    </div>
</div>

<% } %>

    <%- include('./partials/footer') %>

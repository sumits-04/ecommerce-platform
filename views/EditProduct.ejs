<!DOCTYPE html>
<html lang="en" class="w-full overflow-x-hidden">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Product</title>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet"
    />

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-['helvetica_now_display'] m-0 p-0 overflow-x-hidden">

    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>

    <% if(loggedin){ %>

    <!-- Navbar -->
    <nav class="sticky top-0 left-0 z-50 w-screen bg-blue-200 flex flex-col sm:flex-row items-center justify-between px-4 sm:px-5 py-3 shadow-md">

        <img
            src="/images/logo.png"
            alt="logo"
            class="w-28 sm:w-32 md:w-36 h-auto"
        >

        <div class="mt-3 sm:mt-0 mr-0 sm:mr-2 flex flex-wrap justify-center items-center gap-3 sm:gap-5">
            <a class="text-sm sm:text-base" href="/owners/AllProducts">Home</a>
            <a
                class="text-sm sm:text-base"
                href="/account"
            >
                My Account
            </a>

            <a
                class="text-sm sm:text-base text-red-600"
                href="/owners/logout"
            >
                Logout
            </a>

        </div>

    </nav>

    <% } %>


    <!-- Main Content -->
    <div class="min-h-screen w-full">

        <div class="w-full px-4 sm:px-6 md:px-10 py-8 sm:py-12 flex justify-center">

            <main class="w-full max-w-4xl bg-white p-4 sm:p-6 md:p-8 shadow">

                <h2 class="text-xl sm:text-2xl font-bold mb-6">
                    Edit Product
                </h2>


                <form
                    autocomplete="off"
                    action="/owners/EditProducts/<%= product._id %>"
                    method="post"
                >

                    <!-- Product Details -->
                    <div class="mb-8">

                        <h3 class="text-lg sm:text-xl font-semibold mb-3">
                            Product Details
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">

                            <input
                                name="name"
                                type="text"
                                placeholder="Product Name"
                                value="<%= product.name %>"
                                class="border p-2 sm:p-3 rounded w-full"
                            >

                            <input
                                name="price"
                                type="text"
                                placeholder="Product Price"
                                value="<%= product.price %>"
                                class="border p-2 sm:p-3 rounded w-full"
                            >

                            <input
                                name="discount"
                                type="text"
                                placeholder="Discount Price"
                                value="<%= product.discount %>"
                                class="border p-2 sm:p-3 rounded w-full"
                            >

                        </div>

                    </div>


                    <!-- Panel Details -->
                    <div class="mb-6">

                        <h3 class="text-lg sm:text-xl font-semibold mb-4">
                            Panel Details
                        </h3>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

                            <!-- Background Color -->
                            <div class="flex items-center justify-between sm:justify-start gap-4">

                                <label class="font-medium">
                                    Background Color
                                </label>

                                <input
                                    name="bgcolor"
                                    type="color"
                                    value="<%= product.bgcolor %>"
                                    class="w-12 h-8 rounded cursor-pointer"
                                >

                            </div>


                            <!-- Panel Color -->
                            <div class="flex items-center justify-between sm:justify-start gap-4">

                                <label class="font-medium">
                                    Panel Color
                                </label>

                                <input
                                    name="panelcolor"
                                    type="color"
                                    value="<%= product.panelcolor %>"
                                    class="w-12 h-8 rounded cursor-pointer"
                                >

                            </div>


                            <!-- Text Color -->
                            <div class="flex items-center justify-between sm:justify-start gap-4">

                                <label class="font-medium">
                                    Text Color
                                </label>

                                <input
                                    name="textcolor"
                                    type="color"
                                    value="<%= product.textcolor %>"
                                    class="w-12 h-8 rounded cursor-pointer"
                                >

                            </div>

                        </div>

                    </div>


                    <!-- Submit -->
                    <input
                        class="w-full sm:w-auto px-6 py-2 sm:py-3 rounded mt-3 bg-blue-500 text-white cursor-pointer"
                        type="submit"
                        value="Change"
                    >

                </form>

            </main>

        </div>

    </div>


    <%- include('./partials/footer') %>

</body>

</html>
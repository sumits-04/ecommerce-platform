<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
    <nav class="w-full bg-blue-200 flex justify-between px-5 py-3">
      <img src="/images/logo.png" alt="logo" class="w-36 h-auto">
        <div class="mt-2 mr-2 flex gap-5">
          <a href="/account">My Account</a>
          <a class="text-red-600" href="/owners/logout">Logout</a>
        </div>
    </nav>
     <% } %>

<div class="min-h-screen flex flex-col">
                <div class="container px-10 py-20 flex flex-grow">

<main class="w-3/4 bg-white p-8 shadow ml-4">
                        <h2 class="text-xl font-bold mb-4">Edit Product</h2>
                        <form autocomplete="off" action="/owners/EditProducts/<%= product._id %> " method="post">
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold mb-2">Product Details</h3>

                                <div class="grid grid-cols-2 gap-5"> 
                                    <input name="name" type="text" placeholder="Product Name" value="<%= product.name %>"
                                        class="border p-2 rounded w-full">
                                    <input name="price" type="text" placeholder="Product Price" value="<%= product.price %>"
                                        class="border p-2 rounded w-full">
                                    <input name="discount" type="text" placeholder="Discount Price" value="<%= product.discount %>"
                                        class="border p-2 rounded w-full">
                                </div>
                            </div>

                            <div>
                                <h3 class="text-lg font-semibold mb-2">Panel Details</h3>
                                <div class="grid grid-cols-2 gap-4">
                                    <label class="block mb-2 font-medium"> Background Color </label>
                                    <input name="bgcolor" type="color" value="<%= product.bgcolor %>"
                                        class="w-20 h-5 rounded cursor-pointer">
                                        <label class="block mb-2 font-medium"> Panel Color </label>
                                    <input name="panelcolor" type="color" placeholder="Panel Color" value="<%= product.panelcolor %>"
                                        class="w-20 h-5 rounded cursor-pointer">
                                    <label class="block mb-2 font-medium"> Text Color </label>
                                    <input name="textcolor" type="color" placeholder="Text Color" value="<%= product.textcolor %>"
                                        class="w-20 h-5 rounded cursor-pointer">
                                </div>
                            </div>
                            <input class="px-5 py-2 rounded mt-3 bg-blue-500 text-white" type="submit"
                                value="Change">
                        </form>
                    </main>
</div>
</div>
 <%- include('./partials/footer') %>
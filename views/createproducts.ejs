<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
    <nav class="sticky top-0 z-50 w-full bg-blue-200 flex flex-col sm:flex-row items-center justify-between px-4 sm:px-5 py-3 shadow-md">
      <img src="/images/logo.png" alt="logo" class="w-28 sm:w-32 md:w-36 h-auto">
         <div class="mt-3 sm:mt-0 mr-0 sm:mr-2 flex flex-wrap justify-center items-center gap-3 sm:gap-5">
          <a class="text-sm sm:text-base" href="/owners/account">My Account</a>
          <a class="text-sm sm:text-base text-red-600" href="/owners/logout">Logout</a>
        </div>
    </nav>
 <% } %>

    <% if(success.length>0){ %>
        <div class="flash-message fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500 z-[100]">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success %>
            </span>
        </div>
        <% } %>

        <% if(CreatedOwner.length>0){ %>
        <div class="flash-message fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500 z-[100]">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= CreatedOwner %>
            </span>
        </div>
        <% } %> 

            <div class="min-h-screen flex flex-col">
                <div class="w-full px-4 sm:px-6 md:px-10 py-10 sm:py-16 flex flex-col lg:flex-row gap-6">
                    <div class="w-full lg:w-1/4 flex flex-col items-start">
                        <div class="flex flex-row lg:flex-col flex-wrap gap-4 lg:gap-0">
                            <a class="block w-fit mb-2" href="/owners/AllProducts">All Products</a>
                            <a class="block w-fit mb-2" href="/owners/createproducts">Create new product</a>
                        </div>
                    </div>
                   <main class="w-full lg:w-3/4 bg-white p-4 sm:p-6 md:p-8 shadow">
                        <h2 class="text-xl font-bold mb-4">Create New Product</h2>
                        <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold mb-2">Product Details</h3>
                                <div class="mb-4">
                                    <label class="block mb-2 font-medium">Product Image</label>
                                    <input name="image" type="file" class="py-2 px-4 rounded" value="Select File">
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                                    <input name="name" type="text" placeholder="Product Name"
                                        class="border p-2 rounded w-full">
                                    <input name="price" type="text" placeholder="Product Price"
                                        class="border p-2 rounded w-full">
                                    <input name="discount" type="text" placeholder="Discount Price"
                                        class="border p-2 rounded w-full">
                                </div>
                            </div>

                            <div>
                                <h3 class="text-lg font-semibold mb-2">Panel Details</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

    <div class="flex items-center gap-3">
        <label class="font-medium">Background Color</label>
        <input
            name="bgcolor"
            type="color"
            class="w-12 h-8 rounded cursor-pointer"
        >
    </div>

    <div class="flex items-center gap-3">
        <label class="font-medium">Panel Color</label>
        <input
            name="panelcolor"
            type="color"
            class="w-12 h-8 rounded cursor-pointer"
        >
    </div>

    <div class="flex items-center gap-3">
        <label class="font-medium">Text Color</label>
        <input
            name="textcolor"
            type="color"
            class="w-12 h-8 rounded cursor-pointer"
        >
    </div>

</div>
                            </div>
                            <input
    class="w-full sm:w-auto px-5 py-2 rounded mt-5 bg-blue-500 text-white cursor-pointer"
    type="submit"
    value="Create New Product"
>
                        </form>
                    </main>
                </div>
            </div>
            <%- include('./partials/footer') %>
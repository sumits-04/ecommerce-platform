<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="font-['helvetica_now_display']">
    <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
    <nav class="w-full bg-blue-200 flex justify-between px-5 py-3">
      <img src="/images/logo.png" alt="logo" class="w-36 h-auto">
        <div class="flex gap-5">
          <a class="mt-2 mr-2" href="/owners/account">Back</a>
          
        </div>
    </nav>
<% } %>

<h2 class="text-3xl m-5">Change Password</h2>

<form action="/owners/account/change-password" method="POST">
    <div class="flex flex-col items-start ml-10 mt-10 gap-7">
    <input
        type="password"
        name="currentPassword"
        placeholder="Current Password"
        class="px-2 py-1 bg-black text-white rounded-lg" name="email"
        required
    >

    <input
        type="password"
        name="newPassword"
        placeholder="New Password"
        class="px-2 py-1 bg-black text-white rounded-lg" name="email"
        required
    >

    <input
        type="password"
        name="confirmPassword"
        placeholder="Confirm New Password"
        required
        class="px-2 py-1 bg-black text-white rounded-lg" name="email"
    >

    <button class="ml-16 bg-blue-500 text-white px-3 py-1 rounded-md" type="submit">Change Password</button>
        </div>
</form>
<%- include('./partials/footer') %>
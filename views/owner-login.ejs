<%- include('./partials/header') %>

<% if(failled.length>0){ %>
        <div class="flash-message fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500 z-[100]">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= failled %>
            </span>
        </div>
        <% } %>

        <% if(error.length>0){ %>
        <div class="flash-message fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500 z-[100]">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= error %>
            </span>
        </div>
        <% } %>
       

    <div class="w-full min-h-screen flex items-center justify-center px-4 sm:px-6 md:px-10">
        <div class="w-full max-w-md flex items-center justify-center">
            <div class="w-full">
                <h4 class="text-xl sm:text-2xl capitalize mb-5 text-center sm:text-left">Admin Access</h4>
                <form action="/owners/login" method="post">
                    <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                        type="email" placeholder="Email" name="email">
                    <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                        type="password" placeholder="Password" name="password">
                    <input class="w-full sm:w-auto px-5 rounded-full py-3 mt-2 bg-blue-500 text-white cursor-pointer" type="submit" value="Login">
                </form>
            </div>
        </div>
    </div>
    <%- include('./partials/footer') %>
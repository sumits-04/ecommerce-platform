<%- include('./partials/header') %>

<% if(success.length>0){ %>
        <div class="flash-message fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500 z-[100]">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success %>
            </span>
        </div>
        <% } %>

<div class="w-full min-h-screen flex flex-col lg:flex-row items-start px-4 sm:px-6 md:px-10 lg:px-20 py-10 lg:py-20">
        <div class="w-full lg:w-1/4 flex flex-col items-start mb-10 lg:mb-0">
            <div class="flex items-center gap-2">
                <h3>sort by</h3>
                <form action="/shop">
                    <select class="border-[1px] px-2 py-1" name="sortby" id="">
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>
                    </select>
                </form>
            </div>
            <div class="flex flex-col mt-6 lg:mt-20">
                <a class="block w-fit mb-2" href="">New Collection</a>
                <a class="block w-fit mb-2" href="/shop">All Products</a>
                <a class="block w-fit mb-2" href="/discountproducts">Discounted Products</a>
            </div>
            <div class="mt-8 lg:mt-32">
                <a class="block w-fit mb-2" href="">Filter by :</a>
                <a class="block w-fit mb-2" href="">Availability</a>
                <a class="block w-fit mb-2" href="">Discount</a>
            </div>
        </div>

        <div class="w-full lg:w-3/4 flex flex-col gap-5 pb-20">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                <% products.forEach(function(product){ %>
                    
                   <% if(product.discount){ %>
                    <div class="w-full">
                        <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                            <img class="h-40 sm:h-44 md:h-48 object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                alt="">
                        </div>
                        <div
                            class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-4 text-[<%= product.textcolor %>]">
                            <div>
                                <h3>
                                    <%= product.name %>
                                </h3>
                                <h4>₹ <%= product.price %>
                                </h4>
                                <h5>Discount: ₹ <%= product.discount %></h5>
                            </div>
                            <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white" href="/addtocart/<%= product._id %>?from=discount">
                                <i class="ri-add-line"></i>
                            </a>
                        </div>
                    </div>
                    <% }
                }) %>
            </div>
        </div>
    </div>
    <%- include('./partials/footer') %>